<UserControl x:Class="GestureSign.ControlPanel.MainWindowControls.AvailableActions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:applications="clr-namespace:GestureSign.Common.Applications;assembly=GestureSign.Common"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             xmlns:converters="clr-namespace:GestureSign.ControlPanel.Converters"
             xmlns:viewModel="clr-namespace:GestureSign.ControlPanel.ViewModel"
             xmlns:componentmodel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="720"
             Initialized="UserControl_Initialized"
             AllowDrop="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:ActionTitleConverter x:Key="ActionTitleConverter" />
            <converters:ApplicationListHeaderConverter x:Key="ApplicationListHeaderConverter"></converters:ApplicationListHeaderConverter>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:GestureButtonImageConverter x:Key="GestureButtonImageConverter" />

            <Style TargetType="ListBoxItem"
                   BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <EventSetter Event="MouseDoubleClick"
                             Handler="ListBoxItem_OnMouseDoubleClick" />
                <Setter Property="Foreground"
                        Value="{StaticResource Office.TextBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                                <Grid>
                                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    <Rectangle x:Name="SelectionBar"
                                               Width="3"
                                               HorizontalAlignment="Left"
                                               Fill="{StaticResource Office.AccentBrush}"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="Border"
                                            Property="Background"
                                            Value="{StaticResource Office.HoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected"
                                         Value="True">
                                    <Setter TargetName="Border"
                                            Property="Background"
                                            Value="{StaticResource Office.SelectionBrush}" />
                                    <Setter TargetName="SelectionBar"
                                            Property="Visibility"
                                            Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                    <Setter Property="Foreground"
                                            Value="{StaticResource Office.DisabledTextBrush}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsEnabled"
                                                   Value="False" />
                                        <Condition Property="IsSelected"
                                                   Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Border"
                                            Property="Background"
                                            Value="{StaticResource Office.InactiveSelectionBrush}" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <ObjectDataProvider ObjectType="{x:Type viewModel:GestureItemProvider}"
                                x:Key="GestureItemProvider">
            </ObjectDataProvider>
            <ObjectDataProvider ObjectType="{x:Type viewModel:ApplicationItemProvider}"
                                x:Key="ApplicationItemProvider">
            </ObjectDataProvider>
            <ObjectDataProvider ObjectType="{x:Type viewModel:CommandInfoProvider}"
                                x:Key="CommandInfoProvider">
            </ObjectDataProvider>
            <CollectionViewSource x:Key="ActionsViewSource"
                                  Source="{Binding Source={StaticResource CommandInfoProvider},Path=CommandInfos}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Action" />
                </CollectionViewSource.GroupDescriptions>
                <CollectionViewSource.SortDescriptions>
                    <componentmodel:SortDescription PropertyName="ActionName"
                                                    Direction="Ascending" />
                    <componentmodel:SortDescription PropertyName="."
                                                    Direction="Ascending" />
                </CollectionViewSource.SortDescriptions>
            </CollectionViewSource>
            <CollectionViewSource x:Key="ApplicationViewSource"
                                  Source="{Binding Source={StaticResource ApplicationItemProvider},Path=ApplicationItems}">
                <CollectionViewSource.GroupDescriptions>
                    <PropertyGroupDescription PropertyName="Group" />
                </CollectionViewSource.GroupDescriptions>
                <CollectionViewSource.SortDescriptions>
                    <componentmodel:SortDescription PropertyName="." />
                </CollectionViewSource.SortDescriptions>
            </CollectionViewSource>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid SnapsToDevicePixels="True"
          UseLayoutRounding="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"
                              MinWidth="180"
                              MaxWidth="480" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation pane: applications -->
        <Border Grid.Column="0"
                Style="{StaticResource Office.PaneStyle}">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Style="{StaticResource Office.PaneHeaderStyle}">
                    <TextBlock Style="{StaticResource Office.PaneTitleStyle}"
                               Text="{localization:LocalisedText Ribbon.ApplicationsPane}" />
                </Border>
                <ListBox x:Name="lstAvailableApplication"
                         ItemsSource="{Binding Source={StaticResource ApplicationViewSource}}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="lstAvailableApplication_SelectionChanged"
                         ContextMenuOpening="lstAvailableApplication_ContextMenuOpening"
                         BorderThickness="0"
                         Padding="0,2">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem  x:Name="PasteActionMenuItem2"
                                       Header="{localization:LocalisedText Action.PasteAction}"
                                       FontSize="16"
                                       Click="PasteToNewActionMenuItem_Click" />
                            <Separator />
                            <MenuItem  x:Name="DeleteMenuItem"
                                       Header="{localization:LocalisedText Action.Delete}"
                                       FontSize="16"
                                       Click="DeleteMenuItem_Click" />
                            <MenuItem  x:Name="EditMenuItem"
                                       Header="{localization:LocalisedText Action.Edit}"
                                       FontSize="16"
                                       Click="EditApplication_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander IsExpanded="True"
                                                          Style="{StaticResource Office.GroupExpanderStyle}">
                                                    <Expander.Header>
                                                        <TextBlock TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource ApplicationListHeaderConverter}">
                                                                    <Binding  Path="Name"
                                                                              Mode="OneWay" />
                                                                    <Binding  Path="ItemCount"
                                                                              Mode="OneWay" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Expander.Header>
                                                    <Expander.Content>
                                                        <ItemsPresenter />
                                                    </Expander.Content>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="26" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="24,0,0,0" />
                                <Button Click="EditApplication_Click"
                                        Grid.Column="1"
                                        VerticalAlignment="Stretch"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,8,0"
                                        Width="14"
                                        ToolTip="{localization:LocalisedText Action.Edit}">
                                    <Button.Template>
                                        <ControlTemplate>
                                            <Grid Background="Transparent"
                                                  Visibility="{Binding Path=IsSelected,RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}},Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Path Width="14"
                                                      Height="14"
                                                      Stretch="Uniform"
                                                      Data="{StaticResource Icon.Pencil}"
                                                      Fill="{StaticResource Office.AccentBrush}" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}"
                               BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch" />
                            <Setter Property="VerticalContentAlignment"
                                    Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext"
                      Background="Transparent"
                      Focusable="False" />

        <!-- Content pane: actions of the selected application -->
        <Border Grid.Column="2"
                Style="{StaticResource Office.PaneStyle}">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Style="{StaticResource Office.PaneHeaderStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal">
                            <TextBlock Text="{localization:LocalisedText Ribbon.EnableAll}"
                                       Foreground="{StaticResource Office.SecondaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <controls:ToggleSwitch x:Name="ToggleAllActionsToggleSwitch"
                                                   Style="{StaticResource MahApps.Metro.Styles.ToggleSwitch.Win10}"
                                                   IsEnabled="False"
                                                   Click="ToggleAllActionsToggleSwitch_Click"
                                                   VerticalAlignment="Center"
                                                   OffLabel=""
                                                   OnLabel="" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Office.PaneTitleStyle}">
                            <Run Text="{Binding ElementName=lstAvailableApplication,Path=SelectedItem.(applications:IApplication.Name),Mode=OneWay}" />
                            <Run FontWeight="Normal"
                                 Foreground="{StaticResource Office.SecondaryTextBrush}"
                                 Text="{Binding ElementName=lstAvailableActions,Path=Items.Groups.Count,Mode=OneWay,StringFormat={localization:LocalisedText Action.ActionCount}}" />
                        </TextBlock>
                    </DockPanel>
                </Border>
                <!--VirtualizingPanel.IsVirtualizingWhenGrouping="True"-->
                <ListBox x:Name="lstAvailableActions"
                         ItemsSource="{Binding Source={StaticResource ActionsViewSource}}"
                         SelectedValuePath="CommandName"
                         ContextMenuOpening="LstAvailableActions_OnContextMenuOpening"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="lstAvailableActions_SelectionChanged"
                         ScrollViewer.ScrollChanged="LstAvailableActions_OnScrollChanged"
                         ScrollViewer.CanContentScroll="False"
                         BorderThickness="0"
                         SelectionMode="Extended">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander IsExpanded="True"
                                                          Style="{StaticResource Office.GroupExpanderStyle}">
                                                    <Expander.Header>
                                                        <TextBlock TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding Name,Converter={StaticResource ActionTitleConverter}}" />
                                                    </Expander.Header>
                                                    <Expander.Content>
                                                        <Border BorderBrush="{StaticResource Office.PaneBorderBrush}"
                                                                BorderThickness="0,0,0,1"
                                                                Margin="0,0,0,4">
                                                            <DockPanel>
                                                                <Button x:Name="ActionButton"
                                                                        Click="ActionButton_Click"
                                                                        VerticalContentAlignment="Top"
                                                                        HorizontalContentAlignment="Center"
                                                                        OverridesDefaultStyle="True"
                                                                        Width="160"
                                                                        Padding="0"
                                                                        BorderThickness="0"
                                                                        Background="{StaticResource Office.WorkspaceBackgroundBrush}">
                                                                    <Grid x:Name="GestureImageGrid"
                                                                          VerticalAlignment="Top"
                                                                          Height="60">
                                                                        <TextBlock Text="{localization:LocalisedText Action.SelectGesture}"
                                                                                   HorizontalAlignment="Center"
                                                                                   Foreground="{StaticResource Office.SecondaryTextBrush}"
                                                                                   TextWrapping="Wrap"
                                                                                   TextAlignment="Center"
                                                                                   Margin="6,0"
                                                                                   IsHitTestVisible="False"
                                                                                   VerticalAlignment="Center"
                                                                                   Panel.ZIndex="10">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Visibility"
                                                                                            Value="Collapsed" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding ElementName=GestureImage,Path=Source}"
                                                                                                     Value="{x:Null}">
                                                                                            <Setter Property="Visibility"
                                                                                                    Value="Visible" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <Image x:Name="GestureImage"
                                                                               Height="46"
                                                                               Stretch="Uniform"
                                                                               StretchDirection="DownOnly"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center">
                                                                            <Image.Source>
                                                                                <MultiBinding Converter="{StaticResource GestureButtonImageConverter}">
                                                                                    <Binding Source="{StaticResource GestureItemProvider}"
                                                                                             Path="InstanceGestureMap"
                                                                                             Mode="OneWay" />
                                                                                    <Binding  Path="Name.GestureName"
                                                                                              Mode="OneWay" />
                                                                                </MultiBinding>
                                                                            </Image.Source>
                                                                        </Image>
                                                                    </Grid>
                                                                </Button>
                                                                <ItemsPresenter DockPanel.Dock="Right" />
                                                            </DockPanel>
                                                        </Border>
                                                    </Expander.Content>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem  x:Name="SortMenuItem"
                                       Header="{localization:LocalisedText Action.Sort}"
                                       FontSize="16">
                                <MenuItem  x:Name="SortByNameMenuItem"
                                           Header="{localization:LocalisedText ActionDialog.ActionName}"
                                           IsCheckable="True"
                                           IsChecked="True"
                                           Click="SortMenuItem_Click"
                                           Checked="SortMenuItem_Checked"
                                           FontSize="16" />
                                <MenuItem  x:Name="SortByGestureMenuItem"
                                           Header="{localization:LocalisedText Gesture.Header}"
                                           IsCheckable="True"
                                           Click="SortMenuItem_Click"
                                           Checked="SortMenuItem_Checked"
                                           FontSize="16" />
                            </MenuItem>
                            <Separator></Separator>
                            <MenuItem  x:Name="CutActionMenuItem"
                                       Header="{localization:LocalisedText Action.CutAction}"
                                       FontSize="16"
                                       Click="CutActionMenuItem_Click" />
                            <MenuItem  x:Name="CopyActionMenuItem"
                                       Header="{localization:LocalisedText Action.CopyAction}"
                                       FontSize="16"
                                       Click="CopyActionMenuItem_Click" />
                            <MenuItem  x:Name="PasteToNewActionMenuItem"
                                       Header="{localization:LocalisedText Action.PasteToNewAction}"
                                       FontSize="16"
                                       Click="PasteToNewActionMenuItem_Click" />
                            <MenuItem  x:Name="PasteToSelectedActionMenuItem"
                                       Header="{localization:LocalisedText Action.PasteToSelectedAction}"
                                       FontSize="16"
                                       Click="PasteToSelectedActionMenuItem_Click" />
                            <Separator></Separator>
                            <MenuItem  x:Name="DelActionMenuItem"
                                       Header="{localization:LocalisedText Action.Delete}"
                                       FontSize="16"
                                       Click="cmdDeleteCommand_Click" />
                            <Separator></Separator>
                            <MenuItem x:Name="ExportActionMenuItem"
                                      Header="{localization:LocalisedText Common.Export}"
                                      Click="ExportActionMenuItem_Click"
                                      FontSize="16" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="60"
                                  Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <controls:ToggleSwitch  Style="{StaticResource MahApps.Metro.Styles.ToggleSwitch.Win10}"
                                                        Click="CommandCheckBox_Click"
                                                        Grid.Column="1"
                                                        IsChecked="{Binding Path=IsEnabled}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,4,0"
                                                        OffLabel=""
                                                        OnLabel="">
                                </controls:ToggleSwitch>
                                <TextBlock Grid.Column="0"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding CommandName}"
                                           Margin="12,12,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           Width="Auto" />
                                <TextBlock Grid.Column="0"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding Description}"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Top"
                                           Width="Auto"
                                           Foreground="{StaticResource Office.SecondaryTextBrush}"
                                           Margin="12,31,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}"
                               BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch" />
                            <Setter Property="VerticalContentAlignment"
                                    Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel IsItemsHost="True">
                            </StackPanel>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
