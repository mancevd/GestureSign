    <!-- Ribbon tabs -->
    <Style x:Key="Office.RibbonTabStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Office.TextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3,3,0,0" Margin="1,0">
                        <Grid>
                            <ContentPresenter Margin="12,6,12,8" RecognizesAccessKey="True" HorizontalAlignment="Center" />
                            <Rectangle x:Name="Underline" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="12,0,12,1"
                                       VerticalAlignment="Bottom" Fill="{StaticResource Office.AccentBrush}" Visibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Office.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Office.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Office.HoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Office.RibbonFileButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Office.TextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3,3,0,0" Margin="4,0,1,0">
                        <ContentPresenter Margin="12,6,12,8" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Office.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Office.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Office.PressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ribbon group: controls on top, centered label at the bottom, hairline separator on the right -->
    <Style x:Key="Office.RibbonGroupStyle" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ContentPresenter Margin="6,4,6,0" />
                        <TextBlock Grid.Row="1" Margin="6,1,6,4" HorizontalAlignment="Center"
                                   FontSize="11" Foreground="{StaticResource Office.GroupLabelBrush}"
                                   Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Rectangle Grid.RowSpan="2" Width="1" Margin="0,6" HorizontalAlignment="Right"
                                   Fill="{StaticResource Office.GroupSeparatorBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Large ribbon button: 28px glyph above a two-line label; three small buttons stack to the same 66px height -->
    <ControlTemplate x:Key="Office.RibbonLargeButtonTemplate" TargetType="ButtonBase">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="4,3,4,0">
            <StackPanel x:Name="Content">
                <Path Width="28" Height="28" Margin="0,1,0,3" HorizontalAlignment="Center" Stretch="Uniform"
                      Data="{TemplateBinding common:RibbonHelper.Icon}" Fill="{TemplateBinding common:RibbonHelper.IconBrush}" />
                <TextBlock Height="30" MaxWidth="76" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           LineHeight="14" LineStackingStrategy="BlockLineHeight"
                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Office.HoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Office.AccentBrush}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Office.CheckedBrush}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Office.CheckedBorderBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Office.PressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Content" Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Office.RibbonSmallButtonTemplate" TargetType="ButtonBase">
        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1" CornerRadius="3" Padding="3,0,7,0">
            <StackPanel x:Name="Content" Orientation="Horizontal">
                <Path Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" Stretch="Uniform"
                      Data="{TemplateBinding common:RibbonHelper.Icon}" Fill="{TemplateBinding common:RibbonHelper.IconBrush}" />
                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Office.HoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Office.AccentBrush}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Office.CheckedBrush}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Office.CheckedBorderBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Office.PressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Content" Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Office.RibbonButtonBaseStyle" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource Office.TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="common:RibbonHelper.IconBrush" Value="{StaticResource Office.IconBrush}" />
    </Style>

    <Style x:Key="Office.RibbonLargeButtonStyle" TargetType="Button" BasedOn="{StaticResource Office.RibbonButtonBaseStyle}">
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="Height" Value="66" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template" Value="{StaticResource Office.RibbonLargeButtonTemplate}" />
    </Style>

    <Style x:Key="Office.RibbonSmallButtonStyle" TargetType="Button" BasedOn="{StaticResource Office.RibbonButtonBaseStyle}">
        <Setter Property="Height" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template" Value="{StaticResource Office.RibbonSmallButtonTemplate}" />
    </Style>

    <Style x:Key="Office.RibbonLargeToggleStyle" TargetType="RadioButton" BasedOn="{StaticResource Office.RibbonButtonBaseStyle}">
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="Height" Value="66" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template" Value="{StaticResource Office.RibbonLargeButtonTemplate}" />
    </Style>

    <Style x:Key="Office.RibbonSmallToggleStyle" TargetType="RadioButton" BasedOn="{StaticResource Office.RibbonButtonBaseStyle}">
        <Setter Property="Height" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template" Value="{StaticResource Office.RibbonSmallButtonTemplate}" />
    </Style>

    <Style x:Key="Office.SmallStackStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="MinWidth" Value="80" />
    </Style>

    <!-- Icon-only button for the ribbon collapse chevron and status bar view switches -->
    <Style x:Key="Office.IconButtonStyle" TargetType="ButtonBase" BasedOn="{StaticResource Office.RibbonButtonBaseStyle}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="3">
                        <Path x:Name="Glyph" Width="12" Height="12" Stretch="Uniform"
                              Data="{TemplateBinding common:RibbonHelper.Icon}" Fill="{TemplateBinding common:RibbonHelper.IconBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Office.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Office.CheckedBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Office.CheckedBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Office.PressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Workspace panes -->
    <Style x:Key="Office.PaneStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Office.PaneBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Office.PaneBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Office.PaneHeaderStyle" TargetType="Border">
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="BorderBrush" Value="{StaticResource Office.PaneBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Office.PaneTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Office.TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- List view rows: hairline row separators in Details view, light selection with a leading accent bar -->
    <Style x:Key="Office.ListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{StaticResource Office.TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="2,3" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Office.PaneBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <GridViewRowPresenter x:Name="RowPresenter" Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <ContentPresenter x:Name="ContentSite" Visibility="Collapsed" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <Rectangle x:Name="SelectionBar" Width="3" HorizontalAlignment="Left"
                                       Fill="{StaticResource Office.AccentBrush}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="GridView.ColumnCollection" Value="{x:Null}">
                            <Setter TargetName="RowPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="0" />
                            <Setter TargetName="Bd" Property="Margin" Value="2" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Office.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Office.SelectionBrush}" />
                            <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Office.DisabledTextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Office.GridViewColumnHeaderStyle" TargetType="GridViewColumnHeader">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{StaticResource Office.SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" Padding="8,6"
                                BorderBrush="{StaticResource Office.PaneBorderBrush}" BorderThickness="0,0,1,1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" TextElement.FontWeight="SemiBold" />
                        </Border>
                        <Thumb x:Name="PART_HeaderGripper" Width="8" Margin="0,0,-4,0" HorizontalAlignment="Right" Cursor="SizeWE">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Office.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="Role" Value="Padding">
                            <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,1" />
                            <Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Collapsible group header used by grouped lists (chevron + semibold label, no fill) -->
    <Style x:Key="Office.GroupExpanderStyle" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource Office.TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Top" Focusable="False"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      Foreground="{TemplateBinding Foreground}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="Transparent" Padding="4,5,8,5">
                                        <DockPanel>
                                            <Path x:Name="Chevron" DockPanel.Dock="Left" Width="9" Height="9" Margin="2,0,6,0"
                                                  VerticalAlignment="Center" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
                                                  Data="{StaticResource Icon.ChevronRight}" Fill="{StaticResource Office.SecondaryTextBrush}">
                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="ChevronRotation" Angle="0" />
                                                </Path.RenderTransform>
                                            </Path>
                                            <ContentPresenter VerticalAlignment="Center" TextElement.FontWeight="SemiBold" />
                                        </DockPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="90" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Office.HoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Backstage (File) view -->
    <Style x:Key="Office.BackstageItemStyle" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="common:RibbonHelper.IconBrush" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="Transparent" Padding="20,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center" Stretch="Uniform"
                                  Data="{TemplateBinding common:RibbonHelper.Icon}" Fill="{TemplateBinding common:RibbonHelper.IconBrush}" />
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Office.AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Office.AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Office.AccentDarkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Office.BackstageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Light, Segoe UI" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource Office.TextBrush}" />
        <Setter Property="Margin" Value="0,0,0,18" />
    </Style>

    <!-- Status bar -->
    <Style x:Key="Office.StatusTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Office.TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
